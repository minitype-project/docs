---
import InstallCommand from "../components/InstallCommand";
import SiteHeader from "../components/SiteHeader.astro";
import SocialIcons from "../components/SocialIcons.astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>minitype – TypeScript ライブラリとして動作するヘッドレス組版エンジン</title>
    <meta name="description" content="高品質で美しい文書を生成するための TypeScript ライブラリ" />
    <meta name="keywords" content="組版, 組版エンジン, 文書生成, PDF, TypeScript, ライブラリ" />
    <link rel="icon" href="/img/favicon.ico" />
  </head>
  <body>
    <SiteHeader>
      <nav>
        <div class="nav-inner nav-links">
          <a href="/introduction/quick-start/">クイックスタート</a>
          <a href="/references/specification/">リファレンス</a>
        </div>
        <div class="nav-inner nav-social">
          <SocialIcons />
        </div>
      </nav>
    </SiteHeader>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <h1 class="hero-title">minitype</h1>
          <p class="hero-subtitle">TypeScript ライブラリとして動作するヘッドレス組版エンジン</p>
          <p class="hero-desc">高品質で美しい文書を生成するための TypeScript ライブラリ</p>
          <InstallCommand client:load />
          <div class="hero-buttons">
            <a href="/introduction/quick-start/" class="button button-primary">クイックスタート</a>
            <a href="https://www.npmjs.com/package/@minitype/minitype" class="button button-secondary" target="_blank" rel="noopener">npm でパッケージを見る</a>
          </div>
        </div>
      </section>

      <section class="features">
        <div class="features-inner">
          <div class="feature">
            <h2>TypeScript ライブラリ</h2>
            <p>組版機能をライブラリとして利用できるため，単体での利用に加えて，アプリケーションに組込んだり，生成 AI から利用したりと様々なワークフローでの文書生成が実現されます．</p>
          </div>
          <div class="feature">
            <h2>高度な日本語組版</h2>
            <p>禁則処理，縦組，ルビ，ハイフネーション，段組，フロート等の高度な組版やレイアウトに必要な機能を備えています．</p>
          </div>
          <div class="feature">
            <h2>マルチプラットフォーム</h2>
            <p>Node.js，Bun といったサーバサイドの環境に加えて，標準的な Web ブラウザ上でも動作します．</p>
          </div>
        </div>
      </section>

      <section class="examples">
        <div class="examples-inner">
          <h2 class="examples-title">minitype による組版例</h2>
          <div class="examples-grid">
            <div class="example-card">
              <p class="example-label">横組・本文</p>
              <div class="example-thumb"></div>
            </div>
            <div class="example-card">
              <p class="example-label">縦組</p>
              <div class="example-thumb"></div>
            </div>
            <div class="example-card">
              <p class="example-label">段組</p>
              <div class="example-thumb"></div>
            </div>
            <div class="example-card">
              <p class="example-label">ルビ・圏点</p>
              <div class="example-thumb"></div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <p>© 2026 Yuto Wada．本ソフトウェアは，2025 年度下期 未踏アドバンスト事業の支援を受けて開発されました．</p>
      </div>
    </footer>
  </body>
</html>

<style>
  @font-face {
    font-family: "GenInterfaceJP";
    src: url("/fonts/GenInterfaceJP-Regular.ttf") format("truetype");
    font-weight: 100 600;
    font-display: swap;
  }
  @font-face {
    font-family: "GenInterfaceJP";
    src: url("/fonts/GenInterfaceJP-Bold.ttf") format("truetype");
    font-weight: 700 900;
    font-display: swap;
  }

  @font-face {
    font-family: "Noto Sans Mono";
    src: url("/fonts/NotoSansMono-Variable.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }
  
  :root {
    --brand-hue: 310;
  }

  *, *::before, *::after {
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "GenInterfaceJP", ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: #111;
    background: #fff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  nav {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-inner {
    display: flex;
    gap: 24px;
  }

  .nav-social {
    margin-left: auto;
  }

  nav :global(a) {
    font-weight: 500;
    color: #555;
    text-decoration: none;
  }

  nav :global(a:hover) {
    color: hsl(var(--brand-hue), 50%, 50%);
  }

  @media (max-width: 639px) {
    .nav-links {
      display: none;
    }
  }

  /* Hero */
  .hero {
    padding: 64px 32px;
    background: linear-gradient(160deg, #fff 0%, color-mix(in srgb, hsl(var(--brand-hue), 50%, 50%) 6%, #fff) 100%);
  }

  .hero-inner {
    max-width: 1050px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 8px;
    color: hsl(var(--brand-hue), 60%, 65%);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    font-weight: 600;
    margin-bottom: 4px;
    color: #1a1a1a;
  }

  .hero-desc {
    margin-bottom: 40px;
    color: #666;
  }

  .hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 10px 24px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .button:hover {
    opacity: 0.85;
  }

  .button-primary {
    color: #fff;
    background: hsl(var(--brand-hue), 50%, 50%);
  }

  .button-secondary {
    color: #333;
    background: hsl(var(--brand-hue), 50%, 95%);
  }

  /* Features */
  .features {
    padding: 48px 32px;
  }

  .features-inner {
    max-width: 1050px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
  }

  .feature h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .feature p {
    color: #555;
    line-height: 1.7;
  }

  /* ======
     Examples
     ====== */
  .examples {
    padding: 48px 32px 80px 32px;
    background: #fafafa;
  }

  .examples-inner {
    max-width: 1050px;
    margin: 0 auto;
  }

  .examples-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 8px 0;
  }

  .examples-grid {
    display: grid;
    /*
      広い画面では 220px 以上の列を可能な限り詰め込む．
      464 px 以下では 最小値が 50%-12px になり 2 列を維持する．
      W / 2 - 12 px = 220 px より，W = 464 px．
    */
    grid-template-columns: repeat(auto-fill, minmax(min(220px, calc(50% - 12px)), 1fr));
    gap: 24px;
  }

  .example-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .example-thumb {
    width: 100%;
    aspect-ratio: 210 / 297;
    background: color-mix(in srgb, hsl(var(--brand-hue), 30%, 80%) 30%, #e8e8e8);
    border-radius: 6px;
  }

  .example-label {
    color: #666;
    text-align: left;
  }

  footer {
    padding: 0 32px 48px 32px;
    background: #fafafa;
  }

  .footer-inner {
    max-width: 1050px;
    margin: 0 auto;
    color: #888;
    font-size: 0.875rem;
  }
</style>
