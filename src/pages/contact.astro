---
import ContactForm from "../components/ContactForm";
import SiteHeader from "../components/SiteHeader.astro";
import SocialIcons from "../components/SocialIcons.astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>お問い合わせ – minitype</title>
    <meta name="description" content="minitype に関するバグ報告・機能要望・商用利用のご相談・ご質問はこちらから。" />
    <link rel="icon" href="/img/favicon.ico" />
  </head>
  <body>
    <SiteHeader>
      <nav>
        <div class="nav-inner nav-links">
          <a href="/introduction/quick-start/">クイックスタート</a>
          <a href="/references/specification/">リファレンス</a>
        </div>
        <div class="nav-inner nav-social">
          <SocialIcons />
        </div>
      </nav>
    </SiteHeader>

    <main>
      <section class="contact">
        <div class="contact-inner">
          <h1 class="contact-title">お問い合わせ</h1>
          <p class="contact-desc">
            バグ報告，機能要望，商用利用のご相談等に関して，お気軽にお問い合わせください．<br/>
            バグ報告，希望要望は <a href="https://github.com/minitype-project/minitype-feedback">GitHub</a> でも受け付けます． 
          </p>
          <ContactForm client:load />
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <p>© 2026 Yuto Wada．本ソフトウェアは，2025 年度下期 未踏アドバンスト事業の支援を受けて開発されました．</p>
      </div>
    </footer>
  </body>
</html>

<style>
  @font-face {
    font-family: "GenInterfaceJP";
    src: url("/fonts/GenInterfaceJP-Regular.ttf") format("truetype");
    font-weight: 100 600;
    font-display: swap;
  }
  @font-face {
    font-family: "GenInterfaceJP";
    src: url("/fonts/GenInterfaceJP-Bold.ttf") format("truetype");
    font-weight: 700 900;
    font-display: swap;
  }
  @font-face {
    font-family: "Noto Sans Mono";
    src: url("/fonts/NotoSansMono-Variable.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  :root {
    --brand-hue: 310;
  }

  *, *::before, *::after {
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "GenInterfaceJP", ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: #111;
    background: #fff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  nav {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-inner {
    display: flex;
    gap: 20px;
  }

  .nav-social {
    margin-left: auto;
  }

  nav :global(a) {
    font-weight: 500;
    color: #555;
    text-decoration: none;
  }

  nav :global(a:hover) {
    color: hsl(var(--brand-hue), 50%, 50%);
  }

  @media (max-width: 639px) {
    .nav-links {
      display: none;
    }
  }

  .contact {
    padding: 64px 32px 96px;
  }

  .contact-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .contact-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .contact-desc {
    color: #666;
    margin-bottom: 40px;
  }

  /* フォームスタイル（React コンポーネント内の className に対応） */
  :global(.form) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.field) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.label) {
    font-size: 0.9rem;
    font-weight: 600;
    color: #333;
  }

  :global(.input) {
    padding: 10px 12px;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    color: #111;
    background: #fff;
    transition: border-color 0.15s;
    outline: none;
  }

  :global(.input:focus) {
    border-color: hsl(var(--brand-hue), 50%, 50%);
    box-shadow: 0 0 0 3px hsl(var(--brand-hue), 50%, 92%);
  }

  :global(.textarea) {
    resize: vertical;
    min-height: 160px;
  }

  :global(.submit) {
    align-self: flex-start;
    padding: 10px 28px;
    background: hsl(var(--brand-hue), 50%, 50%);
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  :global(.submit:hover:not(:disabled)) {
    opacity: 0.85;
  }

  :global(.submit:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(.success) {
    padding: 32px;
    background: hsl(var(--brand-hue), 50%, 97%);
    border: 1px solid hsl(var(--brand-hue), 50%, 85%);
    border-radius: 12px;
  }

  :global(.success-title) {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: hsl(var(--brand-hue), 50%, 40%);
  }

  :global(.success-desc) {
    color: #555;
  }

  footer {
    padding: 0 32px 48px;
    background: #fafafa;
    border-top: 1px solid #eee;
  }

  .footer-inner {
    max-width: 1050px;
    margin: 0 auto;
    padding-top: 32px;
    color: #888;
    font-size: 0.875rem;
  }
</style>
