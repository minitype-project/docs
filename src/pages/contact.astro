---
import ContactForm from "../components/ContactForm";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="お問い合わせ – minitype"
  description="minitype に関するバグ報告，機能要望，商用利用のご相談等はこちらから"
>
  <section class="contact">
    <div class="contact-inner">
      <h1 class="contact-title">お問い合わせ</h1>
      <p class="contact-desc">
        バグ報告，機能要望，商用利用のご相談等に関して，お気軽にお問い合わせください．<br/>
        バグ報告および機能要望は GitHub の <a href="https://github.com/minitype-project/minitype-feedback" class="link">@minitype/minitype-feedback</a> リポジトリでも受け付けています．オープンな議論が可能となるため，可能な限り GitHub をご利用いただけますと幸いです．
      </p>
      <ContactForm client:load />
    </div>
  </section>
</PageLayout>

<style>
  .contact {
    padding: 64px 32px 96px;
  }

  .contact-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .contact-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .contact-desc {
    color: #666;
    margin-bottom: 40px;
  }

  .link {
    color: hsl(var(--brand-hue), 50%, 50%);
    text-underline-offset: 4px;
  }

  /* フォームスタイル（React コンポーネント内の className に対応） */
  :global(.form) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.field) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.label) {
    font-size: 0.9rem;
    font-weight: 600;
    color: #333;
  }

  :global(.input) {
    padding: 10px 12px;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    color: #111;
    background: #fff;
    transition: border-color 0.15s;
    outline: none;
  }

  :global(.input:focus) {
    border-color: hsl(var(--brand-hue), 50%, 50%);
    box-shadow: 0 0 0 3px hsl(var(--brand-hue), 50%, 92%);
  }

  :global(.textarea) {
    resize: vertical;
    min-height: 160px;
  }

  :global(.submit) {
    align-self: flex-start;
    padding: 10px 28px;
    background: hsl(var(--brand-hue), 50%, 50%);
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  :global(.submit:hover:not(:disabled)) {
    opacity: 0.85;
  }

  :global(.submit:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(.success) {
    padding: 32px;
    background: hsl(var(--brand-hue), 50%, 97%);
    border: 1px solid hsl(var(--brand-hue), 50%, 85%);
    border-radius: 12px;
  }

  :global(.success-title) {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: hsl(var(--brand-hue), 50%, 40%);
  }

  :global(.success-desc) {
    color: #555;
  }
</style>
